# ============================================
#  PCPulse — Windows/.gitignore
# ============================================

# ── Встроенная JDK (≈327 MB) ────────────────
jdk-21.0.3+9/

# ── Apache Maven (≈10 MB) ───────────────────
apache-maven-3.9.6/

# ── Maven build output (≈12 MB) ─────────────
JavaServer/target/

# ── Python cache ────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Исполняемые / бинарные файлы ────────────
*.exe
*.dll
!OpenHardwareMonitorLib.dll
*.so
*.dylib

# ── Логи ────────────────────────────────────
*.log
*.log.*
logs/

# ── Архивы сборки ───────────────────────────
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ── Виртуальные окружения Python ────────────
venv/
.venv/
env/
.env/

# ── IDE / редакторы ─────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── ОС-мусор ───────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ── PyInstaller (если используется) ─────────
build/
dist/
*.spec
